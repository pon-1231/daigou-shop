# 複製這個檔案成 .env，然後把下面的值換成你自己的

# 登入密碼（給你朋友登入用，自己想一組）
APP_PASSWORD=請改成你自己的密碼

# 隨便打一長串亂數字母就好，用來加密登入的 session cookie
SESSION_SECRET=請改成一長串隨機亂碼

# 去 Supabase 專案 → Project Settings → API 複製這兩個值
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=你的 service_role 金鑰（不是 anon key）

# 去 Supabase 專案 → Project Settings → Database → Connection string，選「Session pooler」那個 URI，
# 把裡面的 [YOUR-PASSWORD] 換成你資料庫的密碼。這是用來把登入狀態(session)存進資料庫，
# 這樣伺服器重開/休眠不會把大家登出。沒填也能跑，只是登入狀態只存在記憶體，伺服器一重開就會被登出。
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:你的資料庫密碼@aws-x-xxxxxxx-x.pooler.supabase.com:5432/postgres

# 本機測試用的埠號，通常不用改
PORT=3100
